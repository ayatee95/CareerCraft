# ======================================================================
# CareerCraft - files that must NEVER be published
# ======================================================================

# --- Secrets and local configuration -----------------------------------
includes/config.php
.env
.env.*

# --- Personal uploads (profile pictures, resumes) ----------------------
# Everything inside uploads/ is ignored, except the placeholder files that keep the
# folders (and their protection) in the repository.
uploads/*
!uploads/.htaccess
!uploads/index.html
!uploads/profiles/
!uploads/resumes/
uploads/profiles/*
!uploads/profiles/index.html
uploads/resumes/*
!uploads/resumes/index.html

# --- Database dumps / backups (they contain real user data) -------------
# database/schema.sql is the only .sql file that belongs in the repository.
*.sql
!database/schema.sql
*.sql.gz
*.dump
*.bak
*.backup
backup/
backups/

# --- Editor, system and temporary files --------------------------------
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
error_log
php_errors.log
*.tmp
*.temp
*.swp
*~

# --- Archives and dependencies ------------------------------------------
*.zip
*.rar
*.7z
node_modules/
vendor/

# Keep project media private by default
project-media/*

# Allow selected desktop screenshots
!project-media/screenshots/
project-media/screenshots/*
!project-media/screenshots/desktop/
!project-media/screenshots/mobile/

# Allow selected desktop images only
project-media/screenshots/desktop/*
!project-media/screenshots/desktop/1.png
!project-media/screenshots/desktop/13portfolio.png
!project-media/screenshots/desktop/14portfolio.png
!project-media/screenshots/desktop/9skills.png
!project-media/screenshots/desktop/10projects.png

# Allow selected mobile images only
project-media/screenshots/mobile/*
!project-media/screenshots/mobile/1.jpg
!project-media/screenshots/mobile/2.jpg
!project-media/screenshots/mobile/3.jpg
!project-media/screenshots/mobile/4.jpg

# Keep video local
project-media/video/